# Runtime output from fleetcom-start-all.sh — API/client logs can contain tokens,
# session cookies, and query payloads. Never commit.
logs/
*.log

# Per-machine repo locations written by fleetcom-onboard.sh's prompts.
local.conf

# Per-machine worktree overrides written by "fleetcom worktree use". Kept apart
# from local.conf so that an "onboard --reconfigure" rewrite cannot discard the
# worktree a developer is mid-task on, and so dropping every override is
# deleting one file.
worktrees.conf

# Belt-and-braces: no env files in this repo, ever. Secrets live in the
# per-machine files fleetcom-onboard.sh writes to (auditboard-dev-env/.envrc,
# cascade/.env), both gitignored in their own repos.
.env
.env.*

# macOS Finder artifacts
.DS_Store

# Playwright MCP scratch dir (a Claude session run in this repo may create it)
.playwright-mcp/
