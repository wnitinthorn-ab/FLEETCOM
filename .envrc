# shellcheck shell=bash
# FLEETCOM/.envrc — defers to auditboard-dev-env/.envrc and holds no values of
# its own. Committed deliberately: the only machine-specific thing in it is a
# path, which it reads from the gitignored local.conf.
#
# WHY THIS EXISTS. AuditBoard's real configuration lives in
# auditboard-dev-env/.envrc — including CASCADE_JWT_SECRET, which
# fleetcom-onboard.sh generates and writes there, pairing it with Cascade's
# JWT_AUTH_SHARED_SECRET in cascade/.env. AuditBoard reads it as the env var
# CASCADE_JWT_SECRET (auditboard-backend config/custom-environment-variables.mjs
# maps it to v1.cascade.jwt_secret), so the value only exists in a shell direnv
# has loaded.
#
# A shell sitting in FLEETCOM had none of it. That is not cosmetic: it makes
# FLEETCOM the wrong place to diagnose from, because the same question gets a
# different answer here than it does where the service runs. Reading
# auditboard-backend's config/default.mjs from here shows
# `cascade.jwt_secret: ''` and invites the conclusion that the secret is unset,
# when it is set and paired and merely not present in *this* shell. That exact
# mistake was made, and it is what this file prevents.
#
# `source_env` rather than a copy: one definition, in the repo that owns it. A
# copy is a second place to rotate and a second place to leak from, and it goes
# stale silently the moment `bin/generate-config` rewrites the original.

_fleetcom_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Same default paths.sh uses, overridden by the same local.conf it reads. Only
# the one assignment is pulled out rather than sourcing the whole file, so
# unrelated settings in local.conf (LOGS_VIEW and the other repo paths) cannot
# leak into every shell that enters this directory.
AB_DEVENV_DIR="${AB_DEVENV_DIR:-$HOME/Development/auditboard-dev-env}"
if [ -f "$_fleetcom_dir/local.conf" ]; then
	_configured="$(sed -n 's/^AB_DEVENV_DIR=["'"'"']\{0,1\}\([^"'"'"']*\)["'"'"']\{0,1\}$/\1/p' "$_fleetcom_dir/local.conf" | tail -1)"
	[ -n "$_configured" ] && AB_DEVENV_DIR="$_configured"
	watch_file "$_fleetcom_dir/local.conf"
fi

if [ -f "$AB_DEVENV_DIR/.envrc" ]; then
	# Re-evaluate when the source file changes — `bin/generate-config` rewrites
	# it wholesale, and a stale cached environment here would be the same class
	# of wrong answer this file exists to stop.
	watch_file "$AB_DEVENV_DIR/.envrc"
	source_env "$AB_DEVENV_DIR"
else
	log_status "auditboard-dev-env/.envrc not found at $AB_DEVENV_DIR — run FLEETCOM/fleetcom-onboard.sh"
fi
